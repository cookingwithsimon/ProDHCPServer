<Application x:Class="ProDHCPServer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:ProDHCPServer.App"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="System">
    <Application.Resources>
        <local:StateBrushConverter x:Key="StateBrush" />
        <local:StateWordConverter x:Key="StateWord" />
        <local:StateGlyphConverter x:Key="StateGlyph" />
        <local:VisibleWhenConverter x:Key="VisibleWhen" />

        <local:RunningBrushConverter x:Key="RunningBrush" />
        <!--
            Everything else (type scale, text styles, panel and button shapes, colours, fonts, backdrop) comes from the
            current look: Theme.Apply merges Themes/<Look>.<Dark|Light>.xaml, which itself merges Themes/Shared.xaml.
        -->

        <!-- Kept here rather than in Shared.xaml: it must base on Fluent's TextBox style, which a look file can't see while it loads. -->
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="{DynamicResource TextBody}" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Application.Resources>
</Application>
