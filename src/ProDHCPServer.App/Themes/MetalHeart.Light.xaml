<!--
    Metal Heart, light: polished silver plates on a brushed-chrome backdrop with a blue glow, the same acid-green
    primary button and Orbitron for the big type. Shapes are in MetalHeart.Shapes.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Shared.xaml" />
    <ResourceDictionary Source="MetalHeart.Shapes.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The backdrop: brushed chrome with a blue glow at top right, under the brushed grain. -->
  <DrawingBrush x:Key="WindowBg" Stretch="UniformToFill" Viewbox="0,0,1600,1000" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1600,1000" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#F2F4F7" Offset="0" />
              <GradientStop Color="#B8BEC7" Offset="0.5" />
              <GradientStop Color="#E3E6EB" Offset="1" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="1400,120" RadiusX="900" RadiusY="600" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush><GradientStop Color="#664A9CFF" Offset="0" /><GradientStop Color="#004A9CFF" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="150,950" RadiusX="700" RadiusY="450" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush><GradientStop Color="#4D8FE02A" Offset="0" /><GradientStop Color="#008FE02A" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,300 H1600 V306 H0 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#CCFFFFFF" Offset="0" /><GradientStop Color="#33FFFFFF" Offset="0.5" /><GradientStop Color="#66000000" Offset="1" /></LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,700 H1600 V706 H0 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#CCFFFFFF" Offset="0" /><GradientStop Color="#33FFFFFF" Offset="0.5" /><GradientStop Color="#66000000" Offset="1" /></LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,0 H1600 V1000 H0 Z" Brush="{StaticResource BrushedGrain}" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Surfaces: polished silver. -->
  <LinearGradientBrush x:Key="PanelBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F7F8FA" Offset="0" />
    <GradientStop Color="#D3D8DF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PanelBorder" Color="#8A919B" />
  <SolidColorBrush x:Key="RaisedBg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="RowHover" Color="#E6E9EE" />
  <SolidColorBrush x:Key="SlideOverBg" Color="#EDF0F3" />
  <LinearGradientBrush x:Key="TopBarBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#C9CFD7" Offset="0.5" />
    <GradientStop Color="#A3ABB5" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Scrim" Color="#73000000" />

  <!-- Ink -->
  <SolidColorBrush x:Key="TextPrimary" Color="#14171B" />
  <SolidColorBrush x:Key="TextSecondary" Color="#474D55" />
  <SolidColorBrush x:Key="TextMuted" Color="#656C75" />

  <!-- Status colours. The Soft ones fill banners and the status field. -->
  <SolidColorBrush x:Key="GoodBrush" Color="#3E9A0C" />
  <SolidColorBrush x:Key="WarnBrush" Color="#B36D00" />
  <SolidColorBrush x:Key="BadBrush" Color="#C8201F" />
  <SolidColorBrush x:Key="IdleBrush" Color="#A6ACB4" />
  <SolidColorBrush x:Key="GoodSoft" Color="#DDF5C8" />
  <SolidColorBrush x:Key="WarnSoft" Color="#FBEBC9" />
  <SolidColorBrush x:Key="BadSoft" Color="#F8D9D8" />
  <SolidColorBrush x:Key="IdleSoft" Color="#E3E6EB" />

  <!-- The primary action: acid-green chrome with dark lettering. -->
  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#DDFF6A" Offset="0" />
    <GradientStop Color="#8FE51E" Offset="0.5" />
    <GradientStop Color="#4C9E08" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AccentText" Color="#0B1A02" />
  <SolidColorBrush x:Key="MonoBg" Color="#E4E7EB" />

  <FontFamily x:Key="TextFont">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
  <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Orbitron</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
</ResourceDictionary>
