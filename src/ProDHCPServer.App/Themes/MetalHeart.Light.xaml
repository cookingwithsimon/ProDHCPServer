  <!-- Surfaces: polished silver, slightly see-through so the shards ghost through the plates. -->
  <LinearGradientBrush x:Key="PanelBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E6F7F8FA" Offset="0" />
    <GradientStop Color="#E6D3D8DF" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PanelBorder" Color="#8A919B" />
  <SolidColorBrush x:Key="RaisedBg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="RowHover" Color="#E6E9EE" />
  <SolidColorBrush x:Key="SlideOverBg" Color="#EDF0F3" />
  <LinearGradientBrush x:Key="TopBarBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#C9CFD7" Offset="0.5" />
    <GradientStop Color="#A3ABB5" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Scrim" Color="#73000000" />

  <!-- Ink -->
  <SolidColorBrush x:Key="TextPrimary" Color="#14171B" />
  <SolidColorBrush x:Key="TextSecondary" Color="#474D55" />
  <SolidColorBrush x:Key="TextMuted" Color="#656C75" />

  <!-- Status colours. The Soft ones fill banners and the status field. -->
  <SolidColorBrush x:Key="GoodBrush" Color="#1E8A3A" />
  <SolidColorBrush x:Key="WarnBrush" Color="#B36D00" />
  <SolidColorBrush x:Key="BadBrush" Color="#C8201F" />
  <SolidColorBrush x:Key="IdleBrush" Color="#A6ACB4" />
  <SolidColorBrush x:Key="GoodSoft" Color="#DDF5C8" />
  <SolidColorBrush x:Key="WarnSoft" Color="#FBEBC9" />
  <SolidColorBrush x:Key="BadSoft" Color="#F8D9D8" />
  <SolidColorBrush x:Key="IdleSoft" Color="#E3E6EB" />

  <!-- The primary action: red chrome. -->
  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF6464" Offset="0" />
    <GradientStop Color="#D21818" Offset="0.5" />
    <GradientStop Color="#860A0A" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MonoBg" Color="#E4E7EB" />

  <FontFamily x:Key="TextFont">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
  <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Orbitron</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
