<!--
    Rack faceplate, light: the same panel in brushed silver. Surfaces are separated by tone, never by lines.
    Every key here is read by the XAML with DynamicResource, so the set must stay complete: copy this file to make a new
    look and change the values, not the keys. Brushes may be solid or gradients.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Surfaces: one ground, a panel a tone step up, a raised step for the slide-over and selected rows. -->
  <SolidColorBrush x:Key="WindowBg" Color="#E6E8EB" />
  <SolidColorBrush x:Key="PanelBg" Color="#F4F5F7" />
  <SolidColorBrush x:Key="RaisedBg" Color="#FFFFFF" />
  <SolidColorBrush x:Key="RowHover" Color="#EBEDF0" />
  <SolidColorBrush x:Key="Scrim" Color="#66000000" />

  <!-- Ink -->
  <SolidColorBrush x:Key="TextPrimary" Color="#0E1114" />
  <SolidColorBrush x:Key="TextSecondary" Color="#474F59" />
  <SolidColorBrush x:Key="TextMuted" Color="#5D6570" />

  <!-- Status colours, tuned for readability at arm's length. The Soft ones fill banners and the status field. -->
  <SolidColorBrush x:Key="GoodBrush" Color="#1A7F37" />
  <SolidColorBrush x:Key="WarnBrush" Color="#B26B00" />
  <SolidColorBrush x:Key="BadBrush" Color="#CF222E" />
  <SolidColorBrush x:Key="IdleBrush" Color="#A3AAB3" />
  <SolidColorBrush x:Key="GoodSoft" Color="#D9F2E0" />
  <SolidColorBrush x:Key="WarnSoft" Color="#FBEACB" />
  <SolidColorBrush x:Key="BadSoft" Color="#F9DADC" />
  <SolidColorBrush x:Key="IdleSoft" Color="#F4F5F7" />

  <!-- The primary action and the box for raw technical detail -->
  <SolidColorBrush x:Key="AccentBrush" Color="#0E1114" />
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MonoBg" Color="#ECEEF1" />

  <!-- Shape: panel edges and corners, button edges, a gloss painted over every button, and how round buttons are (0.5 = pill, 0 = square). -->
  <SolidColorBrush x:Key="PanelBorder" Color="Transparent" />
  <Thickness x:Key="PanelBorderThickness">0</Thickness>
  <CornerRadius x:Key="PanelRadius">0</CornerRadius>
  <CornerRadius x:Key="RowRadius">0</CornerRadius>
  <SolidColorBrush x:Key="ButtonBorder" Color="Transparent" />
  <Thickness x:Key="ButtonBorderThickness">0</Thickness>
  <SolidColorBrush x:Key="ButtonGloss" Color="Transparent" />
  <sys:Double x:Key="ButtonCornerScale">0.5</sys:Double>

  <!-- Faces: TextFont for everything you read, DisplayFont for the few big things (status line, device IP, settings title). -->
  <FontFamily x:Key="TextFont">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
  <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#League Spartan</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
</ResourceDictionary>
