<!--
    Frutiger Aero, light: white glass over a sky that runs down into grass, with big soft bubbles and rings drifting
    behind the panels; glossy blue buttons; Segoe UI (the Frutiger of Windows). Shapes are in FrutigerAero.Shapes.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Shared.xaml" />
    <ResourceDictionary Source="FrutigerAero.Shapes.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The backdrop: sky to grass, with bubbles. Drawn at 1600x1000 and scaled to fill the window. -->
  <DrawingBrush x:Key="WindowBg" Stretch="UniformToFill" Viewbox="0,0,1600,1000" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1600,1000" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#DDF1FC" Offset="0" />
              <GradientStop Color="#8ACBF3" Offset="0.4" />
              <GradientStop Color="#4FA9E4" Offset="0.72" />
              <GradientStop Color="#6CBF4E" Offset="0.86" />
              <GradientStop Color="#A9DB5B" Offset="1" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <!-- Sun glow top left -->
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="180,80" RadiusX="520" RadiusY="420" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush><GradientStop Color="#B3FFFFFF" Offset="0" /><GradientStop Color="#00FFFFFF" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <!-- Bubbles: soft filled discs with a thin bright rim -->
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="1290,250" RadiusX="300" RadiusY="300" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush GradientOrigin="0.35,0.3"><GradientStop Color="#66FFFFFF" Offset="0" /><GradientStop Color="#14FFFFFF" Offset="0.7" /><GradientStop Color="#59FFFFFF" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen><Pen Thickness="3"><Pen.Brush><SolidColorBrush Color="#99FFFFFF" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="1060,720" RadiusX="190" RadiusY="190" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush GradientOrigin="0.35,0.3"><GradientStop Color="#59FFFFFF" Offset="0" /><GradientStop Color="#0DFFFFFF" Offset="0.7" /><GradientStop Color="#4DFFFFFF" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen><Pen Thickness="2"><Pen.Brush><SolidColorBrush Color="#8CFFFFFF" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="420,880" RadiusX="130" RadiusY="130" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush GradientOrigin="0.35,0.3"><GradientStop Color="#59FFFFFF" Offset="0" /><GradientStop Color="#0DFFFFFF" Offset="0.7" /><GradientStop Color="#4DFFFFFF" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen><Pen Thickness="2"><Pen.Brush><SolidColorBrush Color="#8CFFFFFF" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- Rings -->
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="1480,640" RadiusX="240" RadiusY="240" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Thickness="14"><Pen.Brush><SolidColorBrush Color="#40FFFFFF" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="760,180" RadiusX="90" RadiusY="90" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Thickness="6"><Pen.Brush><SolidColorBrush Color="#59FFFFFF" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Surfaces: white glass. -->
  <SolidColorBrush x:Key="PanelBg" Color="#B8FFFFFF" />
  <SolidColorBrush x:Key="PanelBorder" Color="#F2FFFFFF" />
  <SolidColorBrush x:Key="RaisedBg" Color="#E6FFFFFF" />
  <SolidColorBrush x:Key="RowHover" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SlideOverBg" Color="#F0F6FBFF" />
  <SolidColorBrush x:Key="TopBarBg" Color="#8CFFFFFF" />
  <SolidColorBrush x:Key="Scrim" Color="#66143C5C" />

  <!-- Ink -->
  <SolidColorBrush x:Key="TextPrimary" Color="#0C2B47" />
  <SolidColorBrush x:Key="TextSecondary" Color="#2E5676" />
  <SolidColorBrush x:Key="TextMuted" Color="#4E7390" />

  <!-- Status colours, tuned for readability at arm's length. The Soft ones fill banners and the status field. -->
  <SolidColorBrush x:Key="GoodBrush" Color="#4DB82A" />
  <SolidColorBrush x:Key="WarnBrush" Color="#F0A020" />
  <SolidColorBrush x:Key="BadBrush" Color="#E2402F" />
  <SolidColorBrush x:Key="IdleBrush" Color="#8DB4CF" />
  <SolidColorBrush x:Key="GoodSoft" Color="#D9E9FADF" />
  <SolidColorBrush x:Key="WarnSoft" Color="#D9FFF1CC" />
  <SolidColorBrush x:Key="BadSoft" Color="#D9FCDCDC" />
  <SolidColorBrush x:Key="IdleSoft" Color="#B8FFFFFF" />

  <!-- The primary action: a glossy blue capsule. -->
  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#7CCBFF" Offset="0" />
    <GradientStop Color="#2A93E6" Offset="0.5" />
    <GradientStop Color="#0F6BC4" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MonoBg" Color="#D9F3F9FE" />

  <FontFamily x:Key="TextFont">Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
</ResourceDictionary>
