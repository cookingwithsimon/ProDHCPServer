<!--
    Metal Heart: the shapes. Steel plates with a bevelled chrome edge and a rivet in each corner, a brushed-metal grain
    over every surface, chrome buttons with a hard highlight, lens status lights, and a chrome strip behind the top
    controls. Colours come from the Dark and Light files, which merge this after Shared.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <CornerRadius x:Key="PanelRadius">6</CornerRadius>
  <CornerRadius x:Key="RowRadius">3</CornerRadius>
  <Thickness x:Key="PanelBorderThickness">1</Thickness>
  <Thickness x:Key="SlideOverBorderThickness">2,0,0,0</Thickness>
  <Thickness x:Key="TopBarPadding">12,8</Thickness>

  <!-- Buttons: nearly square plates, a bevel (light on top, dark below) and a chrome highlight that stops at the middle. -->
  <sys:Double x:Key="ButtonCornerScale">0.18</sys:Double>
  <Thickness x:Key="ButtonBorderThickness">1</Thickness>
  <LinearGradientBrush x:Key="ButtonBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F2FFFFFF" Offset="0" />
    <GradientStop Color="#66FFFFFF" Offset="0.5" />
    <GradientStop Color="#CC000000" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ButtonGloss" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#99FFFFFF" Offset="0" />
    <GradientStop Color="#33FFFFFF" Offset="0.48" />
    <GradientStop Color="#26000000" Offset="0.52" />
    <GradientStop Color="#59000000" Offset="1" />
  </LinearGradientBrush>

  <!-- Brushed grain: fine horizontal lines, tiled over the plates. -->
  <DrawingBrush x:Key="BrushedGrain" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute" Viewbox="0,0,4,4" ViewboxUnits="Absolute" Opacity="0.7">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Geometry="M0,0 H4 V1 H0 Z"><GeometryDrawing.Brush><SolidColorBrush Color="#12FFFFFF" /></GeometryDrawing.Brush></GeometryDrawing>
        <GeometryDrawing Geometry="M0,2 H4 V3 H0 Z"><GeometryDrawing.Brush><SolidColorBrush Color="#1F000000" /></GeometryDrawing.Brush></GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- The bevel around a plate: lit from the top left. -->
  <LinearGradientBrush x:Key="Bevel" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#F4F7FA" Offset="0" />
    <GradientStop Color="#9AA2AC" Offset="0.35" />
    <GradientStop Color="#3C4249" Offset="0.65" />
    <GradientStop Color="#07080A" Offset="1" />
  </LinearGradientBrush>

  <!-- A rivet: a chrome dome. -->
  <RadialGradientBrush x:Key="Rivet" GradientOrigin="0.3,0.3" Center="0.45,0.45" RadiusX="0.6" RadiusY="0.6">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#B5BCC5" Offset="0.45" />
    <GradientStop Color="#4A5058" Offset="0.85" />
    <GradientStop Color="#0A0B0D" Offset="1" />
  </RadialGradientBrush>

  <!-- Status lights become lenses: a bright spot, a dark rim. -->
  <RadialGradientBrush x:Key="LightGloss" GradientOrigin="0.32,0.28" Center="0.45,0.45" RadiusX="0.62" RadiusY="0.62">
    <GradientStop Color="#C2FFFFFF" Offset="0" />
    <GradientStop Color="#26FFFFFF" Offset="0.4" />
    <GradientStop Color="#00000000" Offset="0.75" />
    <GradientStop Color="#66000000" Offset="1" />
  </RadialGradientBrush>

  <!-- A plate: bevel, inner shadow line, grain, rivets. -->
  <ControlTemplate x:Key="PlateTemplate" TargetType="ContentControl">
    <Grid>
      <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Bevel}" BorderThickness="2" CornerRadius="6" />
      <Border Background="{DynamicResource BrushedGrain}" Margin="2" CornerRadius="4" IsHitTestVisible="False" />
      <Border BorderBrush="#99000000" BorderThickness="1" Margin="2" CornerRadius="4" IsHitTestVisible="False" />
      <Ellipse Width="9" Height="9" Fill="{DynamicResource Rivet}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" IsHitTestVisible="False" />
      <Ellipse Width="9" Height="9" Fill="{DynamicResource Rivet}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" IsHitTestVisible="False" />
      <Ellipse Width="9" Height="9" Fill="{DynamicResource Rivet}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7" IsHitTestVisible="False" />
      <Ellipse Width="9" Height="9" Fill="{DynamicResource Rivet}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" IsHitTestVisible="False" />
      <ContentPresenter Margin="{TemplateBinding Padding}" />
    </Grid>
  </ControlTemplate>

  <Style x:Key="Panel" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="Template" Value="{StaticResource PlateTemplate}" />
  </Style>

  <!-- The status field is a plate too, filled with the state's colour and clipped so the big light stays inside. -->
  <Style x:Key="StatusField" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Bevel}" BorderThickness="2" CornerRadius="6" ClipToBounds="True">
              <ContentPresenter />
            </Border>
            <Border Background="{DynamicResource BrushedGrain}" Margin="2" CornerRadius="4" IsHitTestVisible="False" />
            <Border BorderBrush="#99000000" BorderThickness="1" Margin="2" CornerRadius="4" IsHitTestVisible="False" />
            <Ellipse Width="9" Height="9" Fill="{DynamicResource Rivet}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" IsHitTestVisible="False" />
            <Ellipse Width="9" Height="9" Fill="{DynamicResource Rivet}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7" IsHitTestVisible="False" />
            <Ellipse Width="9" Height="9" Fill="{DynamicResource Rivet}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7" IsHitTestVisible="False" />
            <Ellipse Width="9" Height="9" Fill="{DynamicResource Rivet}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The top bar is a chrome strip with the same bevel. -->
  <Style x:Key="TopBar" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource TopBarBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Bevel}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="{DynamicResource TopBarPadding}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <!-- Banners get the bevel too. -->
  <Style x:Key="Banner" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Bevel}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="24,16" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
</ResourceDictionary>
