<!--
    Metal Heart, dark: gunmetal plates on a dark brushed-steel backdrop lit by an electric-blue glow, with an acid-green
    chrome primary button and Orbitron for the big type (the Winamp and Sonique skin era). Shapes are in
    MetalHeart.Shapes.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Shared.xaml" />
    <ResourceDictionary Source="MetalHeart.Shapes.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The backdrop: dark steel with a blue glow at top right and a green one at bottom left, under the brushed grain. -->
  <DrawingBrush x:Key="WindowBg" Stretch="UniformToFill" Viewbox="0,0,1600,1000" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1600,1000" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#2A2E35" Offset="0" />
              <GradientStop Color="#0E1013" Offset="0.5" />
              <GradientStop Color="#1E2126" Offset="1" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="1400,120" RadiusX="900" RadiusY="600" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush><GradientStop Color="#802E8CFF" Offset="0" /><GradientStop Color="#002E8CFF" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="150,950" RadiusX="700" RadiusY="450" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush><GradientStop Color="#5A7CFF2A" Offset="0" /><GradientStop Color="#007CFF2A" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <!-- A couple of chrome rails across the backdrop -->
        <GeometryDrawing Geometry="M0,300 H1600 V306 H0 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#66FFFFFF" Offset="0" /><GradientStop Color="#1AFFFFFF" Offset="0.5" /><GradientStop Color="#99000000" Offset="1" /></LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,700 H1600 V706 H0 Z">
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#66FFFFFF" Offset="0" /><GradientStop Color="#1AFFFFFF" Offset="0.5" /><GradientStop Color="#99000000" Offset="1" /></LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,0 H1600 V1000 H0 Z" Brush="{StaticResource BrushedGrain}" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Surfaces: gunmetal. -->
  <LinearGradientBrush x:Key="PanelBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#363B43" Offset="0" />
    <GradientStop Color="#1C1F24" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PanelBorder" Color="#7A818A" />
  <SolidColorBrush x:Key="RaisedBg" Color="#3F454E" />
  <SolidColorBrush x:Key="RowHover" Color="#4F5660" />
  <SolidColorBrush x:Key="SlideOverBg" Color="#24282E" />
  <LinearGradientBrush x:Key="TopBarBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#6B737D" Offset="0" />
    <GradientStop Color="#3A3F46" Offset="0.5" />
    <GradientStop Color="#1E2126" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Scrim" Color="#BF000000" />

  <!-- Ink -->
  <SolidColorBrush x:Key="TextPrimary" Color="#EEF1F5" />
  <SolidColorBrush x:Key="TextSecondary" Color="#B4BCC6" />
  <SolidColorBrush x:Key="TextMuted" Color="#858E98" />

  <!-- Status colours: acid green for good. The Soft ones fill banners and the status field. -->
  <SolidColorBrush x:Key="GoodBrush" Color="#9BFF3C" />
  <SolidColorBrush x:Key="WarnBrush" Color="#FFC53D" />
  <SolidColorBrush x:Key="BadBrush" Color="#FF4D4D" />
  <SolidColorBrush x:Key="IdleBrush" Color="#5A626C" />
  <SolidColorBrush x:Key="GoodSoft" Color="#233A12" />
  <SolidColorBrush x:Key="WarnSoft" Color="#3A2E0E" />
  <SolidColorBrush x:Key="BadSoft" Color="#421616" />
  <SolidColorBrush x:Key="IdleSoft" Color="#24282E" />

  <!-- The primary action: acid-green chrome with dark lettering. -->
  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#DDFF6A" Offset="0" />
    <GradientStop Color="#8FE51E" Offset="0.5" />
    <GradientStop Color="#4C9E08" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AccentText" Color="#0B1A02" />
  <SolidColorBrush x:Key="MonoBg" Color="#0F1114" />

  <FontFamily x:Key="TextFont">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
  <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Orbitron</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
</ResourceDictionary>
