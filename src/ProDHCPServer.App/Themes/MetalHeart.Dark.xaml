  <!-- Surfaces: gunmetal, slightly see-through so the shards ghost through the plates. -->
  <LinearGradientBrush x:Key="PanelBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E0363B43" Offset="0" />
    <GradientStop Color="#E61C1F24" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PanelBorder" Color="#7A818A" />
  <SolidColorBrush x:Key="RaisedBg" Color="#3F454E" />
  <SolidColorBrush x:Key="RowHover" Color="#4F5660" />
  <SolidColorBrush x:Key="SlideOverBg" Color="#24282E" />
  <LinearGradientBrush x:Key="TopBarBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#6B737D" Offset="0" />
    <GradientStop Color="#3A3F46" Offset="0.5" />
    <GradientStop Color="#1E2126" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Scrim" Color="#BF000000" />

  <!-- Ink -->
  <SolidColorBrush x:Key="TextPrimary" Color="#EEF1F5" />
  <SolidColorBrush x:Key="TextSecondary" Color="#B4BCC6" />
  <SolidColorBrush x:Key="TextMuted" Color="#858E98" />

  <!-- Status colours. The Soft ones fill banners and the status field. -->
  <SolidColorBrush x:Key="GoodBrush" Color="#41D15F" />
  <SolidColorBrush x:Key="WarnBrush" Color="#FFC53D" />
  <SolidColorBrush x:Key="BadBrush" Color="#FF4D4D" />
  <SolidColorBrush x:Key="IdleBrush" Color="#5A626C" />
  <SolidColorBrush x:Key="GoodSoft" Color="#233A12" />
  <SolidColorBrush x:Key="WarnSoft" Color="#3A2E0E" />
  <SolidColorBrush x:Key="BadSoft" Color="#421616" />
  <SolidColorBrush x:Key="IdleSoft" Color="#24282E" />

  <!-- The primary action: red chrome. -->
  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF6464" Offset="0" />
    <GradientStop Color="#D21818" Offset="0.5" />
    <GradientStop Color="#860A0A" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MonoBg" Color="#0F1114" />

  <FontFamily x:Key="TextFont">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
  <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Orbitron</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
