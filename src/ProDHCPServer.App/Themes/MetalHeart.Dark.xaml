<!--
    Metal Heart, dark: brushed steel plates with bevelled edges and a chrome-red primary button.
    Every key here is read by the XAML with DynamicResource, so the set must stay complete: copy this file to make a new
    look and change the values, not the keys. Brushes may be solid or gradients.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Surfaces: one ground, a panel a tone step up, a raised step for the slide-over and selected rows. -->
  <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#26292E" Offset="0" />
    <GradientStop Color="#17191C" Offset="0.5" />
    <GradientStop Color="#2A2E33" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PanelBg" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2E3238" Offset="0" />
    <GradientStop Color="#1E2126" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="RaisedBg" Color="#3B4048" />
  <SolidColorBrush x:Key="RowHover" Color="#4A5059" />
  <SolidColorBrush x:Key="Scrim" Color="#B3000000" />

  <!-- Ink -->
  <SolidColorBrush x:Key="TextPrimary" Color="#E9ECEF" />
  <SolidColorBrush x:Key="TextSecondary" Color="#AEB5BE" />
  <SolidColorBrush x:Key="TextMuted" Color="#7F8791" />

  <!-- Status colours, tuned for readability at arm's length. The Soft ones fill banners and the status field. -->
  <SolidColorBrush x:Key="GoodBrush" Color="#41D15F" />
  <SolidColorBrush x:Key="WarnBrush" Color="#F5B531" />
  <SolidColorBrush x:Key="BadBrush" Color="#FF4A4A" />
  <SolidColorBrush x:Key="IdleBrush" Color="#596069" />
  <SolidColorBrush x:Key="GoodSoft" Color="#16301D" />
  <SolidColorBrush x:Key="WarnSoft" Color="#33290C" />
  <SolidColorBrush x:Key="BadSoft" Color="#3D1414" />
  <SolidColorBrush x:Key="IdleSoft" Color="#1E2126" />

  <!-- The primary action and the box for raw technical detail -->
  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF5050" Offset="0" />
    <GradientStop Color="#C21414" Offset="0.5" />
    <GradientStop Color="#8E0B0B" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MonoBg" Color="#121417" />

  <!-- Shape: panel edges and corners, button edges, a gloss painted over every button, and how round buttons are (0.5 = pill, 0 = square). -->
  <LinearGradientBrush x:Key="PanelBorder" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#7D838C" Offset="0" />
    <GradientStop Color="#2A2D31" Offset="0.5" />
    <GradientStop Color="#050506" Offset="1" />
  </LinearGradientBrush>
  <Thickness x:Key="PanelBorderThickness">1</Thickness>
  <CornerRadius x:Key="PanelRadius">2</CornerRadius>
  <CornerRadius x:Key="RowRadius">2</CornerRadius>
  <LinearGradientBrush x:Key="ButtonBorder" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#9DA3AB" Offset="0" />
    <GradientStop Color="#0C0D0F" Offset="1" />
  </LinearGradientBrush>
  <Thickness x:Key="ButtonBorderThickness">1</Thickness>
  <LinearGradientBrush x:Key="ButtonGloss" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#59FFFFFF" Offset="0" />
    <GradientStop Color="#14FFFFFF" Offset="0.45" />
    <GradientStop Color="#00000000" Offset="0.5" />
    <GradientStop Color="#26000000" Offset="1" />
  </LinearGradientBrush>
  <sys:Double x:Key="ButtonCornerScale">0.12</sys:Double>

  <!-- Faces: TextFont for everything you read, DisplayFont for the few big things (status line, device IP, settings title). -->
  <FontFamily x:Key="TextFont">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
  <FontFamily x:Key="DisplayFont">Bahnschrift, Impact, Segoe UI</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Assets/Fonts/#Figtree</FontFamily>
</ResourceDictionary>
