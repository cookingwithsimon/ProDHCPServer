<!--
    Frutiger Aero, dark: black glass widgets (the KDE 4 / Oxygen desktop) over deep teal with glowing bubbles and
    rings; the same glossy blue buttons. Shapes are in FrutigerAero.Shapes.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Shared.xaml" />
    <ResourceDictionary Source="FrutigerAero.Shapes.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The backdrop: deep teal, lit from the right, with glowing bubbles. Drawn at 1600x1000 and scaled to fill. -->
  <DrawingBrush x:Key="WindowBg" Stretch="UniformToFill" Viewbox="0,0,1600,1000" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1600,1000" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#041B26" Offset="0" />
              <GradientStop Color="#0A4A5E" Offset="0.55" />
              <GradientStop Color="#0E6E80" Offset="1" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <!-- Glow from the lower right -->
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="1350,760" RadiusX="700" RadiusY="520" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush><GradientStop Color="#9933C6E0" Offset="0" /><GradientStop Color="#0033C6E0" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <!-- Bubbles: glowing discs with a bright rim -->
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="1290,250" RadiusX="300" RadiusY="300" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush GradientOrigin="0.35,0.3"><GradientStop Color="#4DB8F0FF" Offset="0" /><GradientStop Color="#0DB8F0FF" Offset="0.7" /><GradientStop Color="#59B8F0FF" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen><Pen Thickness="3"><Pen.Brush><SolidColorBrush Color="#99C8F4FF" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="1060,720" RadiusX="190" RadiusY="190" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush GradientOrigin="0.35,0.3"><GradientStop Color="#40B8F0FF" Offset="0" /><GradientStop Color="#0DB8F0FF" Offset="0.7" /><GradientStop Color="#4DB8F0FF" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen><Pen Thickness="2"><Pen.Brush><SolidColorBrush Color="#8CC8F4FF" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="420,880" RadiusX="130" RadiusY="130" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <RadialGradientBrush GradientOrigin="0.35,0.3"><GradientStop Color="#40B8F0FF" Offset="0" /><GradientStop Color="#0DB8F0FF" Offset="0.7" /><GradientStop Color="#4DB8F0FF" Offset="1" /></RadialGradientBrush>
          </GeometryDrawing.Brush>
          <GeometryDrawing.Pen><Pen Thickness="2"><Pen.Brush><SolidColorBrush Color="#8CC8F4FF" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- Rings -->
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="1480,640" RadiusX="240" RadiusY="240" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Thickness="14"><Pen.Brush><SolidColorBrush Color="#33C8F4FF" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><EllipseGeometry Center="760,180" RadiusX="90" RadiusY="90" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Pen><Pen Thickness="6"><Pen.Brush><SolidColorBrush Color="#59C8F4FF" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Surfaces: black glass. -->
  <SolidColorBrush x:Key="PanelBg" Color="#B3070B0E" />
  <SolidColorBrush x:Key="PanelBorder" Color="#66FFFFFF" />
  <SolidColorBrush x:Key="RaisedBg" Color="#38FFFFFF" />
  <SolidColorBrush x:Key="RowHover" Color="#55FFFFFF" />
  <SolidColorBrush x:Key="SlideOverBg" Color="#EE070B0E" />
  <SolidColorBrush x:Key="TopBarBg" Color="#B3000000" />
  <SolidColorBrush x:Key="Scrim" Color="#99000A10" />

  <!-- Ink -->
  <SolidColorBrush x:Key="TextPrimary" Color="#F4FAFF" />
  <SolidColorBrush x:Key="TextSecondary" Color="#BFD6E6" />
  <SolidColorBrush x:Key="TextMuted" Color="#8FB0C4" />

  <!-- Status colours, tuned for readability at arm's length. The Soft ones fill banners and the status field. -->
  <SolidColorBrush x:Key="GoodBrush" Color="#5AE06A" />
  <SolidColorBrush x:Key="WarnBrush" Color="#FFC247" />
  <SolidColorBrush x:Key="BadBrush" Color="#FF6B5E" />
  <SolidColorBrush x:Key="IdleBrush" Color="#5A7A8C" />
  <SolidColorBrush x:Key="GoodSoft" Color="#C20F3D1A" />
  <SolidColorBrush x:Key="WarnSoft" Color="#C2473507" />
  <SolidColorBrush x:Key="BadSoft" Color="#C24A1414" />
  <SolidColorBrush x:Key="IdleSoft" Color="#B3070B0E" />

  <!-- The primary action: a glossy blue capsule. -->
  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#7CCBFF" Offset="0" />
    <GradientStop Color="#2A93E6" Offset="0.5" />
    <GradientStop Color="#0F6BC4" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MonoBg" Color="#80000000" />

  <FontFamily x:Key="TextFont">Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI</FontFamily>
  <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
</ResourceDictionary>
