<Window x:Class="ProDHCPServer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProDHCPServer.App"
        xmlns:vm="clr-namespace:ProDHCPServer.App.ViewModels"
        xmlns:status="clr-namespace:ProDHCPServer.Core.Status;assembly=ProDHCPServer.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ProDHCPServer" Width="1320" Height="860" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Closing="OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshAdaptersCommand}" />
    </Window.InputBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Top bar: adapter picker + Start/Stop ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="ProDHCPServer" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="DHCP for the device on the end of your cable" FontSize="12" Foreground="{DynamicResource TextMuted}" />
            </StackPanel>

            <ComboBox Grid.Column="1" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                      IsEnabled="{Binding SettingsEditable}" MinHeight="56" MaxWidth="620" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Network adapter" ToolTip="The adapter your cable is plugged into">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AdapterItemViewModel}">
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center"
                                     Fill="{Binding LinkState, Converter={StaticResource StateBrush}}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="  " /><Run Text="{Binding KindText, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontWeight="Normal" FontSize="13" />
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding LinkText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Info.Description, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Grid.Column="2" Content="↻" FontSize="20" Width="48" MinHeight="56" Margin="8,0,0,0"
                    Command="{Binding RefreshAdaptersCommand}" ToolTip="Refresh adapters (F5)" AutomationProperties.Name="Refresh adapters" />
            <Button Grid.Column="3" Content="⚙  Settings" FontSize="15" MinHeight="56" Padding="16,0" Margin="8,0,0,0"
                    Command="{Binding ToggleSettingsCommand}" ToolTip="Server IP, pool, lease time and options" />
            <Button Grid.Column="4" MinWidth="170" MinHeight="56" Margin="16,0,0,0" FontSize="22" FontWeight="SemiBold"
                    Command="{Binding StartStopCommand}" Content="{Binding StartStopText}" Foreground="White">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Background" Value="{DynamicResource GoodBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BadBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- ===== Headline: the one line that matters ===== -->
        <Border Grid.Row="1" CornerRadius="10" Padding="20,14" Margin="0,0,0,12" BorderThickness="6,0,0,0"
                Background="{Binding HeadlineState, Converter={StaticResource StateBrush}, ConverterParameter=Soft}"
                BorderBrush="{Binding HeadlineState, Converter={StaticResource StateBrush}}">
            <StackPanel>
                <TextBlock Text="{Binding HeadlineText}" FontSize="26" FontWeight="SemiBold" Style="{StaticResource Primary}"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="{Binding HeadlineAction}" FontSize="16" Margin="0,4,0,0" Style="{StaticResource Secondary}"
                           Visibility="{Binding HeadlineAction, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </Border>

        <!-- ===== Banners ===== -->
        <StackPanel Grid.Row="2">
            <!-- Crash recovery -->
            <Border CornerRadius="10" Padding="16,12" Margin="0,0,0,12" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1"
                    Visibility="{Binding PendingRecovery, Converter={StaticResource VisibleWhen}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RecoveryText}" FontSize="15" Style="{StaticResource Primary}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <Button Content="Restore now" Style="{StaticResource AccentButton}" Padding="16,8" Command="{Binding RestorePendingCommand}" />
                        <Button Content="Keep current settings" Padding="16,8" Margin="8,0,0,0" Command="{Binding DiscardPendingCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Another DHCP server -->
            <Border CornerRadius="10" Padding="16,12" Margin="0,0,0,12" Background="{DynamicResource BadSoft}" BorderBrush="{DynamicResource BadBrush}" BorderThickness="2"
                    Visibility="{Binding OtherServerText, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Style="{StaticResource Primary}" VerticalAlignment="Center">
                            <Run Text="⚠ " Foreground="{DynamicResource BadBrush}" /><Run Text="{Binding OtherServerText, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                            <Button Content="Stop" Padding="16,8" Command="{Binding StartStopCommand}" />
                            <Button Content="Serve anyway…" Padding="16,8" Margin="8,0,0,0" Command="{Binding ServeAnywayCommand}" />
                        </StackPanel>
                    </Grid>
                    <Expander Header="Technical detail" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}"
                              Visibility="{Binding OtherServerDetail, Converter={StaticResource VisibleWhen}}">
                        <TextBox Text="{Binding OtherServerDetail, Mode=OneWay}" Style="{StaticResource MonoBox}" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Errors -->
            <Border CornerRadius="10" Padding="16,12" Margin="0,0,0,12" Background="{DynamicResource BadSoft}" BorderBrush="{DynamicResource BadBrush}" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ErrorMessage}" FontSize="15" FontWeight="SemiBold" Style="{StaticResource Primary}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                            <Button Content="Retry restore" Padding="14,6" Margin="0,0,8,0" Command="{Binding RetryRestoreCommand}"
                                    Visibility="{Binding CanRetryRestore, Converter={StaticResource VisibleWhen}}" />
                            <Button Content="Copy" Padding="14,6" Margin="0,0,8,0" Command="{Binding CopyTextCommand}" CommandParameter="{Binding ErrorDetail}"
                                    Visibility="{Binding ErrorDetail, Converter={StaticResource VisibleWhen}}" />
                            <Button Content="Dismiss" Padding="14,6" Command="{Binding DismissErrorCommand}" />
                        </StackPanel>
                    </Grid>
                    <Expander Header="Technical detail" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}"
                              Visibility="{Binding ErrorDetail, Converter={StaticResource VisibleWhen}}">
                        <TextBox Text="{Binding ErrorDetail, Mode=OneWay}" Style="{StaticResource MonoBox}" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Overlapping Wi-Fi/other adapter -->
            <Border CornerRadius="10" Padding="16,10" Margin="0,0,0,12" Background="{DynamicResource WarnSoft}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1"
                    Visibility="{Binding ConflictText, Converter={StaticResource VisibleWhen}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ConflictText}" FontSize="15" Style="{StaticResource Primary}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Turn it off until Stop" Padding="16,8" Margin="16,0,0,0" Command="{Binding TurnOffConflictingCommand}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- ===== Main: status chain | device ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Status chain -->
            <Border Style="{StaticResource Panel}" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Steps}" AutomationProperties.Name="Status checks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StepViewModel}">
                                <Border Padding="10,8" Margin="0,0,0,2" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="36" Height="36" VerticalAlignment="Top" Margin="0,2,14,0">
                                            <Ellipse Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                            <TextBlock Text="{Binding State, Converter={StaticResource StateGlyph}}" Foreground="White" FontSize="18" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Number}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static status:StepState.Idle}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{Binding Reason}" FontSize="17" Style="{StaticResource Primary}" Margin="0,1,0,0" />
                                            <TextBlock Text="{Binding Action}" FontSize="14" Margin="0,3,0,0" FontStyle="Italic"
                                                       Foreground="{Binding State, Converter={StaticResource StateBrush}}" TextWrapping="Wrap"
                                                       Visibility="{Binding Action, Converter={StaticResource VisibleWhen}}" />
                                            <Expander Header="Details" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                      Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}">
                                                <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource MonoBox}" Margin="0,4,0,0" />
                                            </Expander>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding State, Converter={StaticResource StateWord}}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{Binding State, Converter={StaticResource StateBrush}}" Margin="12,4,0,0" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Device panel -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="20"
                    Visibility="{Binding SettingsOpen, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="DEVICE" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding DeviceCountText}" HorizontalAlignment="Right" FontSize="13" Foreground="{DynamicResource TextMuted}" />
                        </Grid>

                        <!-- No device yet -->
                        <StackPanel Visibility="{Binding FocusedDevice, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" Margin="0,24,0,0">
                            <TextBlock Text="No device has an address yet" FontSize="22" FontWeight="SemiBold" Style="{StaticResource Primary}" />
                            <TextBlock Margin="0,8,0,0" FontSize="15" Style="{StaticResource Secondary}"
                                       Text="Press Start, then plug in or power-cycle the device. Its IP, name and manufacturer appear here as soon as it takes a lease." />
                        </StackPanel>

                        <!-- Focused device -->
                        <StackPanel DataContext="{Binding FocusedDevice}" Visibility="{Binding Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Style="{StaticResource Primary}" />
                            <TextBlock Text="{Binding Vendor}" FontSize="15" Style="{StaticResource Secondary}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Ip}" FontSize="46" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Primary}"
                                           AutomationProperties.Name="Device IP address" />
                                <Button Grid.Column="1" Content="Copy" Margin="14,0,0,0" Padding="14,6" VerticalAlignment="Center"
                                        Command="{Binding DataContext.CopyIpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="MAC" Style="{StaticResource Secondary}" Margin="0,2,16,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MacText}" FontFamily="{StaticResource MonoFont}" FontSize="15" Style="{StaticResource Primary}" />
                                <TextBlock Grid.Row="1" Text="Lease" Style="{StaticResource Secondary}" Margin="0,2,16,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LeaseText}" FontSize="15" Style="{StaticResource Primary}" />
                                <TextBlock Grid.Row="2" Text="Seen" Style="{StaticResource Secondary}" Margin="0,2,16,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FirstSeenText}" FontSize="15" Style="{StaticResource Primary}" />
                                <TextBlock Grid.Row="3" Text="Vendor ID" Style="{StaticResource Secondary}" Margin="0,2,16,2"
                                           Visibility="{Binding VendorClass, Converter={StaticResource VisibleWhen}}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VendorClass}" FontSize="15" Style="{StaticResource Primary}"
                                           Visibility="{Binding VendorClass, Converter={StaticResource VisibleWhen}}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding FocusedDevice, Converter={StaticResource VisibleWhen}}" Margin="0,18,0,0">
                            <Button Content="Open WebUI" Style="{StaticResource AccentButton}" FontSize="22" MinHeight="64" HorizontalAlignment="Stretch"
                                    Command="{Binding OpenWebUiCommand}" ToolTip="Opens the device in your browser (http or https, whichever port is open)" />
                            <TextBlock Text="{Binding WebUiHint}" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                            <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                                <Button Content="http :80" Padding="12,6" Margin="0,0,6,6" Command="{Binding OpenPortCommand}" CommandParameter="http:80" />
                                <Button Content="https :443" Padding="12,6" Margin="0,0,6,6" Command="{Binding OpenPortCommand}" CommandParameter="https:443" />
                                <Button Content="http :8080" Padding="12,6" Margin="0,0,6,6" Command="{Binding OpenPortCommand}" CommandParameter="http:8080" />
                                <Button Content="https :8443" Padding="12,6" Margin="0,0,6,6" Command="{Binding OpenPortCommand}" CommandParameter="https:8443" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- All devices (switch case) -->
                        <TextBlock Text="ALL DEVICES" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"
                                   Visibility="{Binding Devices.Count, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                                    <Button Margin="0,0,0,6" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.FocusDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                            ToolTip="Show this device above">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Margin="0,0,10,0" Fill="{Binding StateColour, Converter={StaticResource StateBrush}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Style="{StaticResource Primary}">
                                                    <Run Text="{Binding Ip, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text="   " /><Run Text="{Binding Title, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="12" Style="{StaticResource Secondary}">
                                                    <Run Text="{Binding MacText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Vendor, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LeaseText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="◀ shown" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                                                       Visibility="{Binding IsFocused, Converter={StaticResource VisibleWhen}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Settings panel (replaces the device panel while open) -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="20"
                    Visibility="{Binding SettingsOpen, Converter={StaticResource VisibleWhen}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Settings}">
                        <TextBlock Text="SERVER SETTINGS" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Stop the server to change these." FontSize="13" Foreground="{DynamicResource WarnBrush}"
                                   Visibility="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />
                        <StackPanel IsEnabled="{Binding DataContext.SettingsEditable, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="Server IP (set on your adapter)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
                            <TextBlock Text="Subnet" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Prefixes}" SelectedItem="{Binding Prefix}" FontSize="15" />
                            <TextBlock Text="Address pool" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PoolStart, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
                                <TextBlock Grid.Column="1" Text="to" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                                <TextBox Grid.Column="2" Text="{Binding PoolEnd, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
                                <Button Grid.Column="3" Content="Suggest" Margin="8,0,0,0" Padding="10,4"
                                        Command="{Binding DataContext.SuggestPoolCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Grid>
                            <TextBlock Text="Lease time (minutes)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding LeaseMinutes, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
                            <TextBlock Text="Gateway (option 3, optional)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Router, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
                            <TextBlock Text="DNS servers (option 6, optional, comma separated)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding DnsServers, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
                            <CheckBox IsChecked="{Binding AlwaysBroadcast}" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource Primary}" Text="Always broadcast replies (for devices that never accept an offer)" />
                            </CheckBox>
                        </StackPanel>
                        <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Themes}" SelectedItem="{Binding Theme}" FontSize="15" />

                        <TextBlock Text="{Binding Errors}" Foreground="{DynamicResource BadBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding Errors, Converter={StaticResource VisibleWhen}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Save" Style="{StaticResource AccentButton}" Padding="20,8"
                                    Command="{Binding DataContext.SaveSettingsFormCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Close" Padding="20,8" Margin="8,0,0,0"
                                    Command="{Binding DataContext.ToggleSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Defaults" Padding="20,8" Margin="8,0,0,0"
                                    Command="{Binding DataContext.ResetSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    IsEnabled="{Binding DataContext.SettingsEditable, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Session log ===== -->
        <Expander Grid.Row="4" Margin="0,12,0,0" IsExpanded="True" Foreground="{DynamicResource TextSecondary}">
            <Expander.Header>
                <TextBlock Text="Session log" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
            </Expander.Header>
            <Grid Height="170" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="LogList" ItemsSource="{Binding LogRows}" Background="{DynamicResource PanelBg}"
                         VirtualizingPanel.IsVirtualizing="True" Loaded="OnLogLoaded">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LogItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Severity, Converter={StaticResource StateBrush}}" />
                                <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding Severity, Converter={StaticResource StateBrush}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBox Grid.Column="2" Style="{StaticResource MonoBox}" MaxHeight="10000"
                         Text="{Binding SelectedItem.Entry, ElementName=LogList, Mode=OneWay, Converter={x:Static local:LogDetailConverter.Instance}}" />
            </Grid>
        </Expander>
    </Grid>
</Window>
